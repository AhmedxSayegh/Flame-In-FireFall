# ================================================================
#  Gemini settings for the Flame in Freefall dashboard
#  Edit this file, save it, then restart:  python app.py
# ================================================================

# 1) Paste your Gemini API key after the = sign (no quotes, no spaces).
GEMINI_API_KEY=

# 2) Choose the model. "gemini-flash-latest" always points to Google's newest Flash model.
#    To pin one model for a stable demo, replace it with a model ID from
#    https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Used automatically if the main model is overloaded (503) or times out. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# How long the model reasons before answering: low, medium or high. Lower is faster.
GEMINI_THINKING_LEVEL=minimal

# Seconds to wait for one Gemini answer. A normal answer takes 15-30 s; after this it retries once, then uses the fallback model.
GEMINI_TIMEOUT_S=60

# Default for how reports are sent: pdf (full PDFs), text (extracted text), none (records only)
REPORT_MODE=text

# PDFs larger than this (MB) go through the Gemini Files API instead of inline upload
INLINE_PDF_LIMIT_MB=18

# Characters of relevant report pages sent per report (text mode)
REPORT_EXCERPT_CHARS=60000

# Experiments sent per investigation (pre-selected in code by relevance)
EXPERIMENTS_PER_INVESTIGATION=12

# Optional cap on the answer length; leave empty to use the model's default
GEMINI_MAX_OUTPUT_TOKENS=

PORT=5000
